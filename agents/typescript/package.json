{
    "name": "@coderone/agent-random",
    "version": "1.0.0",
    "license": "MIT",
    "private": true,
    "dependencies": {
        "@coderone/bomberland-library": "^4.0.0",
        "typescript": "^4.7.3",
        "ws": "^8.8.1"
    },
    "scripts": {
        "check-dependencies": "depcheck",
        "build": "tsc --build tsconfig.json",
        "start": "tsc --build tsconfig.json && concurrently \"tsc --watch\" \"nodemon ./dist/Agent.js\"",
        "start:fwd": "tsc --build tsconfig.json && concurrently \"tsc --watch\" \"nodemon ./dist/Agent_fwd.js\"",
        "run": "node ./dist/Agent.js",
        "run:fwd": "node ./dist/Agent_fwd.js"
    },
    "devDependencies": {
        "@types/node": "^14.14.41",
        "@types/ws": "^8.5.3",
        "concurrently": "^5.3.0",
        "depcheck": "^1.4.0",
        "nodemon": "^2.0.7"
    }
}
